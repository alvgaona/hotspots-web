            plugins: [{
                id: 'modelLabels',
                afterDatasetsDraw: (chart) => {
                    const ctx = chart.ctx;
                    ctx.font = "11px 'IBM Plex Sans Variable', sans-serif";
                    ctx.fillStyle = '#374151';

                    chart.data.datasets[0].data.forEach((point: any, i: number) => {
                        const meta = chart.getDatasetMeta(0);
                        const pos = meta.data[i];
                        ctx.fillText(point.label, pos.x + 10, pos.y - 5);
                    });
                }
            }]
        });
    }

    // Inference data from benchmark results
    const inferenceData = {
        cpu_ms: [161.4, 371.4, 941.3, 1118.9, 2525.1, 1415.2, 2716.3],  // CPU inference time in ms
        gpu_ms: [15.5, 23.3, 36.6, 44.6, 55.3, 63.7, 79.2],             // GPU inference time in ms
        cpu_fps: [6.2, 2.7, 1.1, 0.9, 0.4, 0.7, 0.4],                   // CPU frames per second
        gpu_fps: [64.5, 42.9, 27.3, 22.4, 18.1, 15.7, 12.6]             // GPU frames per second
    };
    // Note: Model order is YOLO11-N, YOLO11-S, YOLO11-M, YOLO11-L, YOLO11-X, RT-DETR-L, RT-DETR-X
    const inferenceModels = ['YOLO11-N', 'YOLO11-S', 'YOLO11-M', 'YOLO11-L', 'YOLO11-X', 'RT-DETR-L', 'RT-DETR-X'];
    const inferenceColors = [
        modelColors[2], // YOLO11-N - Yellow
        modelColors[3], // YOLO11-S - Teal
        modelColors[4], // YOLO11-M - Blue
        modelColors[5], // YOLO11-L - Purple
        modelColors[6], // YOLO11-X - Green
        modelColors[1], // RT-DETR-L - Orange
        modelColors[0], // RT-DETR-X - Red
    ];

    // Inference Time Chart (dual y-axis)
    const inferenceTimeCtx = document.getElementById('chart-inference-time') as HTMLCanvasElement;
    if (inferenceTimeCtx) {
        new Chart(inferenceTimeCtx, {
            type: 'bar',
            data: {
                labels: inferenceModels,
                datasets: [
                    {
                        label: 'CPU',
                        data: inferenceData.cpu_ms,
                        backgroundColor: 'rgba(59, 130, 246, 0.8)',
                        borderColor: 'rgba(59, 130, 246, 1)',
                        borderWidth: 1,
                        yAxisID: 'y'
                    },
                    {
                        label: 'GPU',
                        data: inferenceData.gpu_ms,
                        backgroundColor: 'rgba(34, 197, 94, 0.8)',
                        borderColor: 'rgba(34, 197, 94, 1)',
                        borderWidth: 1,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: {
                        display: true,
                        text: 'Mean Inference Time Comparison',
                        font: { size: 12, weight: 'normal' }
                    },
                    legend: {
                        position: 'top',
                        labels: { font: { size: 10 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: (context) => `${context.dataset.label}: ${context.raw} ms`
                        }
                    }
                },
                scales: {
                    y: {
                        type: 'linear',
                        position: 'left',
                        beginAtZero: true,
                        max: 2800,
                        title: {
                            display: true,
                            text: 'CPU Time (ms)',
                            color: 'rgba(59, 130, 246, 1)'
                        },
                        ticks: {
                            font: { size: 10 },
                            color: 'rgba(59, 130, 246, 1)'
                        },
                        grid: {
                            drawOnChartArea: true
                        }
                    },
                    y1: {
                        type: 'linear',
                        position: 'right',
                        beginAtZero: true,
                        max: 80,
                        title: {
                            display: true,
                            text: 'GPU Time (ms)',
                            color: 'rgba(34, 197, 94, 1)'
                        },
                        ticks: {
                            font: { size: 10 },
                            color: 'rgba(34, 197, 94, 1)'
                        },
                        grid: {
                            drawOnChartArea: false
                        }
                    },
                    x: {
                        ticks: {
                            font: { size: 9 },
                            maxRotation: 45,
                            minRotation: 45
                        }
                    }
                }
            }
        });
    }

    // FPS Chart (dual y-axis)
    const fpsCtx = document.getElementById('chart-fps') as HTMLCanvasElement;
    if (fpsCtx) {
        new Chart(fpsCtx, {
            type: 'bar',
            data: {
                labels: inferenceModels,
                datasets: [
                    {
                        label: 'CPU',
