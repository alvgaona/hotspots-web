                        backgroundColor: 'rgba(59, 130, 246, 0.8)',
                        borderColor: 'rgba(59, 130, 246, 1)',
                        borderWidth: 1,
                        yAxisID: 'y'
                    },
                    {
                        label: 'GPU',
                        data: inferenceData.gpu_fps,
                        backgroundColor: 'rgba(34, 197, 94, 0.8)',
                        borderColor: 'rgba(34, 197, 94, 1)',
                        borderWidth: 1,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: {
                        display: true,
                        text: 'Frames Per Second Comparison',
                        font: { size: 12, weight: 'normal' }
                    },
                    legend: {
                        position: 'top',
                        labels: { font: { size: 10 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: (context) => `${context.dataset.label}: ${context.raw} FPS`
                        }
                    }
                },
                scales: {
                    y: {
                        type: 'linear',
                        position: 'left',
                        beginAtZero: true,
                        max: 8,
                        title: {
                            display: true,
                            text: 'CPU FPS',
                            color: 'rgba(59, 130, 246, 1)'
                        },
                        ticks: {
                            font: { size: 10 },
                            color: 'rgba(59, 130, 246, 1)'
                        },
                        grid: {
                            drawOnChartArea: true
                        }
                    },
                    y1: {
                        type: 'linear',
                        position: 'right',
                        beginAtZero: true,
                        max: 70,
                        title: {
                            display: true,
                            text: 'GPU FPS',
                            color: 'rgba(34, 197, 94, 1)'
                        },
                        ticks: {
                            font: { size: 10 },
                            color: 'rgba(34, 197, 94, 1)'
                        },
                        grid: {
                            drawOnChartArea: false
                        }
                    },
                    x: {
                        ticks: {
                            font: { size: 9 },
                            maxRotation: 45,
                            minRotation: 45
                        }
                    }
                }
            }
        });
    }

    // GPU Speedup Factor Chart
    const speedupCtx = document.getElementById('chart-speedup') as HTMLCanvasElement;
    if (speedupCtx) {
        // Calculate speedup: CPU_time / GPU_time
        const speedupData = inferenceData.cpu_ms.map((cpu, i) =>
            Math.round(cpu / inferenceData.gpu_ms[i])
        );

        new Chart(speedupCtx, {
            type: 'bar',
            data: {
                labels: inferenceModels,
                datasets: [{
                    label: 'Speedup Factor',
                    data: speedupData,
                    backgroundColor: inferenceColors.map(c => c.bg),
                    borderColor: inferenceColors.map(c => c.border),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: {
                    title: {
                        display: true,
                        text: 'GPU Speedup vs CPU',
                        font: { size: 12, weight: 'normal' }
                    },
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: (context) => `${context.raw}x faster on GPU`
                        }
                    }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        title: { display: true, text: 'Speedup Factor' },
                        ticks: {
                            font: { size: 10 },
                            callback: (value) => value + 'x'
                        }
                    },
                    y: {
                        ticks: { font: { size: 9 } }
                    }
                }
            }
        });
