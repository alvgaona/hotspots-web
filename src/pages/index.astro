                                                </tr>
                                                <tr>
                                                    <td class="border p-2">Laptop/workstation</td>
                                                    <td class="border p-2">YOLO11-S or YOLO11-M</td>
                                                    <td class="border p-2">Any modern CPU, or GPU for real-time</td>
                                                </tr>
                                                <tr>
                                                    <td class="border p-2">Server/cloud</td>
                                                    <td class="border p-2">YOLO11-M or YOLO11-L</td>
                                                    <td class="border p-2">GPU recommended, ~0.3GB VRAM</td>
                                                </tr>
                                            </tbody>
