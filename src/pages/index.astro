<script>
    import { Chart, registerables } from 'chart.js';
    Chart.register(...registerables);

    // Set global font to match website
    Chart.defaults.font.family = "'IBM Plex Sans Variable', sans-serif";

    const models = ['RT-DETR-X', 'RT-DETR-L', 'YOLO11-N', 'YOLO11-S', 'YOLO11-M', 'YOLO11-L', 'YOLO11-X'];

    // Data from the paper (Figure 6)
    const data = {
        'mAP50-95': [0.218, 0.230, 0.280, 0.293, 0.307, 0.281, 0.307],
        'mAP50': [0.489, 0.512, 0.537, 0.625, 0.662, 0.625, 0.641],
        'Precision': [0.537, 0.491, 0.491, 0.638, 0.658, 0.617, 0.617],
        'Recall': [0.677, 0.715, 0.671, 0.715, 0.701, 0.710, 0.711]
    };

    // Unique color per model (consistent across all charts)
    const modelColors = [
        { bg: 'rgba(255, 99, 132, 0.8)', border: 'rgba(255, 99, 132, 1)' },   // RT-DETR-X - Red
        { bg: 'rgba(255, 159, 64, 0.8)', border: 'rgba(255, 159, 64, 1)' },   // RT-DETR-L - Orange
        { bg: 'rgba(255, 205, 86, 0.8)', border: 'rgba(255, 205, 86, 1)' },   // YOLO11-N - Yellow
        { bg: 'rgba(75, 192, 192, 0.8)', border: 'rgba(75, 192, 192, 1)' },   // YOLO11-S - Teal
        { bg: 'rgba(54, 162, 235, 0.8)', border: 'rgba(54, 162, 235, 1)' },   // YOLO11-M - Blue
        { bg: 'rgba(153, 102, 255, 0.8)', border: 'rgba(153, 102, 255, 1)' }, // YOLO11-L - Purple
        { bg: 'rgba(46, 204, 113, 0.8)', border: 'rgba(46, 204, 113, 1)' },   // YOLO11-X - Green
    ];

    function getColors(_values: number[]) {
        return modelColors;
    }

    function createChart(canvasId: string, title: string, values: number[], yMax: number) {
        const ctx = document.getElementById(canvasId) as HTMLCanvasElement;
        if (!ctx) return;

        const colors = getColors(values);

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: models,
                datasets: [{
                    label: title,
                    data: values,
                    backgroundColor: colors.map(c => c.bg),
                    borderColor: colors.map(c => c.border),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: {
                        display: true,
                        text: `(${String.fromCharCode(97 + ['mAP50-95', 'mAP50', 'Precision', 'Recall'].indexOf(title))}) ${title}`,
                        font: { size: 12, weight: 'normal' }
                    },
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: (context) => `${title}: ${(context.raw as number * 100).toFixed(1)}%`
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: yMax,
                        ticks: {
                            callback: (value) => (Number(value) * 100).toFixed(0) + '%',
                            font: { size: 10 }
                        }
                    },
                    x: {
                        ticks: {
                            font: { size: 9 },
                            maxRotation: 45,
                            minRotation: 45
                        }
                    }
                }
            }
        });
    }

    // Create all 4 charts
    createChart('chart-map50-95', 'mAP50-95', data['mAP50-95'], 0.35);
    createChart('chart-map50', 'mAP50', data['mAP50'], 0.8);
    createChart('chart-precision', 'Precision', data['Precision'], 0.8);
    createChart('chart-recall', 'Recall', data['Recall'], 0.8);

    // Training time data (from training-time-analysis)
    const trainingModels = ['RT-DETR-X', 'RT-DETR-L', 'YOLO11-N', 'YOLO11-S', 'YOLO11-M', 'YOLO11-L', 'YOLO11-X'];
    const trainingData = {
        totalHours: [10.8, 5.1, 1.4, 2.1, 5.0, 4.7, 6.1],
        timePerEpoch: [5.3, 1.4, 0.6, 0.9, 1.5, 1.9, 2.9]
    };

    // Colors matching the image: RT-DETR (teal), YOLO11 (orange)
    const trainingColors = trainingModels.map(m =>
        m.startsWith('RT-DETR')
            ? { bg: 'rgba(69, 162, 158, 0.8)', border: 'rgba(69, 162, 158, 1)' }
            : { bg: 'rgba(230, 159, 0, 0.8)', border: 'rgba(230, 159, 0, 1)' }
    );

    // Total Training Time Chart
    const totalTimeCtx = document.getElementById('chart-total-training-time') as HTMLCanvasElement;
    if (totalTimeCtx) {
        new Chart(totalTimeCtx, {
            type: 'bar',
            data: {
                labels: trainingModels,
                datasets: [{
                    label: 'Total Training Time',
                    data: trainingData.totalHours,
                    backgroundColor: trainingColors.map(c => c.bg),
                    borderColor: trainingColors.map(c => c.border),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: {
                        display: true,
                        text: '(a) Total Training Time',
                        font: { size: 12, weight: 'normal' }
                    },
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: (context) => `${context.raw}h`
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: 'Total Training Time (hours)' },
                        ticks: {
                            font: { size: 10 },
                            callback: (value) => value + 'h'
                        }
                    },
                    x: {
                        ticks: {
                            font: { size: 9 },
                            maxRotation: 45,
                            minRotation: 45
                        }
                    }
                }
            }
        });
    }

    // Time per Epoch Chart
    const epochTimeCtx = document.getElementById('chart-time-per-epoch') as HTMLCanvasElement;
    if (epochTimeCtx) {
        new Chart(epochTimeCtx, {
            type: 'bar',
            data: {
                labels: trainingModels,
                datasets: [{
                    label: 'Time per Epoch',
                    data: trainingData.timePerEpoch,
                    backgroundColor: trainingColors.map(c => c.bg),
                    borderColor: trainingColors.map(c => c.border),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: {
                        display: true,
                        text: '(b) Time per Epoch',
                        font: { size: 12, weight: 'normal' }
                    },
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: (context) => `${context.raw}m`
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: 'Time per Epoch (minutes)' },
                        ticks: {
                            font: { size: 10 },
                            callback: (value) => value + 'm'
                        }
                    },
                    x: {
                        ticks: {
                            font: { size: 9 },
                            maxRotation: 45,
                            minRotation: 45
                        }
                    }
                }
            }
        });
    }

    // Precision vs Recall scatter plot
    const prCtx = document.getElementById('chart-precision-recall') as HTMLCanvasElement;
    if (prCtx) {
        // Data points: { x: recall, y: precision }
        const scatterData = models.map((model, i) => ({
            x: data['Recall'][i],
            y: data['Precision'][i],
            label: model
        }));

        // Use same colors as other charts
        const pointColors = modelColors.map(c => c.border);

        new Chart(prCtx, {
            type: 'scatter',
            data: {
                datasets: [{
                    label: 'Models',
                    data: scatterData,
                    backgroundColor: pointColors,
                    borderColor: pointColors,
                    pointRadius: 8,
                    pointHoverRadius: 10
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: {
                        display: true,
                        text: 'Precision vs Recall: Model Comparison',
                        font: { size: 14, weight: 'normal' }
                    },
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: (context) => {
                                const point = context.raw as { x: number; y: number; label: string };
                                return [
                                    point.label,
                                    `Precision: ${(point.y * 100).toFixed(1)}%`,
                                    `Recall: ${(point.x * 100).toFixed(1)}%`
                                ];
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        title: { display: true, text: 'Recall' },
                        min: 0.4,
                        max: 1.0,
                        ticks: {
                            callback: (value) => (Number(value) * 100).toFixed(0) + '%'
