    // Model Size Chart
    const modelSizeCtx = document.getElementById('chart-model-size') as HTMLCanvasElement;
    if (modelSizeCtx) {
        // Model file size from benchmark (in MB)
        const modelSizeData = [5, 18, 39, 49, 109, 63, 129];

        new Chart(modelSizeCtx, {
            type: 'bar',
            data: {
                labels: inferenceModels,
                datasets: [{
                    label: 'Model Size',
                    data: modelSizeData,
                    backgroundColor: inferenceColors.map(c => c.bg),
                    borderColor: inferenceColors.map(c => c.border),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: {
                    title: {
                        display: true,
                        text: 'Model Size',
                        font: { size: 12, weight: 'normal' }
                    },
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: (context) => `${context.raw} MB`
                        }
                    }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        title: { display: true, text: 'Size (MB)' },
                        ticks: {
                            font: { size: 10 },
                            callback: (value) => value + ' MB'
                        }
                    },
                    y: {
                        ticks: { font: { size: 9 } }
                    }
                }
            }
        });
    }

    // Comprehensive comparison chart (grouped bar)
    const compCtx = document.getElementById('chart-comprehensive') as HTMLCanvasElement;
    if (compCtx) {
        new Chart(compCtx, {
            type: 'bar',
            data: {
                labels: models,
                datasets: [
                    {
                        label: 'mAP50-95',
                        data: data['mAP50-95'],
                        backgroundColor: 'rgba(255, 99, 132, 0.8)',
                        borderColor: 'rgba(255, 99, 132, 1)',
                        borderWidth: 1
                    },
                    {
                        label: 'mAP50',
                        data: data['mAP50'],
                        backgroundColor: 'rgba(255, 159, 64, 0.8)',
                        borderColor: 'rgba(255, 159, 64, 1)',
                        borderWidth: 1
                    },
                    {
                        label: 'Precision',
                        data: data['Precision'],
                        backgroundColor: 'rgba(54, 162, 235, 0.8)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1
                    },
                    {
                        label: 'Recall',
                        data: data['Recall'],
                        backgroundColor: 'rgba(75, 192, 192, 0.8)',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        borderWidth: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: {
                        display: true,
                        text: 'Comprehensive Performance Comparison: All Metrics',
                        font: { size: 14, weight: 'normal' }
                    },
                    legend: {
                        position: 'top',
                        labels: { font: { size: 11 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: (context) => `${context.dataset.label}: ${(context.raw as number * 100).toFixed(1)}%`
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 1.0,
                        ticks: {
                            callback: (value) => (Number(value) * 100).toFixed(0) + '%',
                            font: { size: 10 }
                        },
                        title: {
                            display: true,
                            text: 'Score'
                        }
                    },
                    x: {
                        ticks: {
                            font: { size: 10 },
                            maxRotation: 45,
                            minRotation: 45
                        },
                        title: {
                            display: true,
                            text: 'Model'
                        }
                    }
                }
            }
        });
    }

    // Copy BibTeX functionality
    const copyButton = document.getElementById('copy-bibtex');
    const bibtexCode = document.getElementById('bibtex');
    const copyText = document.getElementById('copy-text');
    const copyIcon = copyButton?.querySelector('i');
    if (copyButton && bibtexCode && copyText && copyIcon) {
        copyButton.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(bibtexCode.textContent || '');
                copyText.textContent = 'Copied!';
                copyIcon.className = 'ph ph-check text-sm';
                copyButton.classList.remove('bg-[#f2f0ea]', 'hover:bg-[#dcdad4]', 'text-gray-600');
                copyButton.classList.add('bg-green-100', 'text-green-700');
                setTimeout(() => {
                    copyText.textContent = 'Copy';
                    copyIcon.className = 'ph ph-copy text-sm';
                    copyButton.classList.remove('bg-green-100', 'text-green-700');
                    copyButton.classList.add('bg-[#f2f0ea]', 'hover:bg-[#dcdad4]', 'text-gray-600');
                }, 2000);
            } catch (err) {
                console.error('Failed to copy:', err);
            }
        });
    }
</script>
